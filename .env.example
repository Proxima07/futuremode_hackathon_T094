# Provider 優先序，逗號分隔，由左到右 fallback
VLM_PROVIDER_CHAIN=nchc,gmi,openai
VLM_TIMEOUT_MS=2500
# 即時構圖需要穩定而非創意；0 可減少相鄰影格的回答漂移
VLM_TEMPERATURE=0

# 國網中心（OpenAI 相容端點）
NCHC_BASE_URL=
NCHC_API_KEY=
NCHC_MODEL=gemma-4-26B-A4B-it

# GMI Cloud（贊助商，備援）
GMI_BASE_URL=
GMI_API_KEY=
GMI_MODEL=

# OpenAI（最後保底）
OPENAI_API_KEY=
OPENAI_MODEL=

# ElevenLabs（僅用於商品描述朗讀，非即時引導）
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 送給 VLM 的影像長邊上限
IMAGE_MAX_EDGE=512
